# Price Stradamus Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=price-stradamus
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=price_stradamus
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5432/price_stradamus

# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_BASE_URL=https://api.binance.com

# Trading Configuration
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TIMEFRAME=1m
DEFAULT_LOOKBACK_CANDLES=60
DEFAULT_PREDICTION_STEPS=5

# Model Configuration
MODEL_SAVE_PATH=./models
DEFAULT_MODEL=nbeats
DEVICE=cuda  # cuda or cpu

# Training Configuration
BATCH_SIZE=32
LEARNING_RATE=0.001
EPOCHS=100
EARLY_STOPPING_PATIENCE=10

# AutoML Configuration
AUTOML_TIME_BUDGET=3600  # seconds
AUTOML_ENSEMBLE_SIZE=10

# Feature Engineering
USE_TECHNICAL_INDICATORS=true
NORMALIZATION_METHOD=minmax  # minmax, standard, robust

# Evaluation
MIN_TRAIN_SIZE=1000
TEST_SIZE=0.2
VALIDATION_SIZE=0.1

# API Rate Limiting
BINANCE_RATE_LIMIT=1200  # requests per minute
REQUEST_TIMEOUT=30  # seconds
MAX_RETRIES=3
